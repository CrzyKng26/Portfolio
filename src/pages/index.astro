---
import Studio from '../layouts/Studio.astro';
import ProjectArt from '../components/studio/ProjectArt.astro';
import { profile, projects, capabilities } from '../data/portfolio';
---
<Studio home>
  <div id="world" aria-hidden="true"><div class="world-fallback"></div></div>
  <aside class="chapter-rail" aria-label="Page sections">
    {['top','works','about','experience','capabilities','contact'].map((id,i)=><a href={`#${id}`} class:list={['chapter', {active:i===0}]} data-chapter={id} aria-label={id}><span>{id}</span><i></i></a>)}
  </aside>
  <section class="hero" id="top" aria-label="Balachander Kannan — independent developer">
    <div class="hero-stage">
    <div class="hero-portrait" aria-hidden="true"><img src="/images/profile/kannan-hero-1080.webp" srcset="/images/profile/kannan-hero-720.webp 720w, /images/profile/kannan-hero-1080.webp 1080w" sizes="(max-width: 760px) 100vw, 80vw" width="1080" height="1440" alt="" fetchpriority="high" decoding="async" /></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-absorption" aria-hidden="true">
      <span class="hero-orbit"></span><span class="hero-orbit hero-orbit-secondary"></span>
      <span class="hero-absorption-core"></span>
      {Array.from({length:12},(_,i)=><span class="hero-trail" style={`--angle:${i * 30}deg`}></span>)}
    </div>
    <div class="hero-mark-anchor" aria-hidden="true"><span class="hero-mark-fallback">K</span></div>
    <div class="hero-eyebrow"><span>Independent developer</span><span>Chennai, India · 13.08° N, 80.27° E</span></div>
    <h1 class="hero-wordmark" aria-label="Kannan">{'KANNAN'.split('').map(letter=><span class="hero-letter" aria-hidden="true">{letter}</span>)}</h1>
    <div class="hero-bottom">
      <div class="hero-intro"><p>Websites that feel.<br/>Systems that ship.</p><span>Balachander Kannan<br/>Web · AI · Automation</span></div>
      <div class="hero-news"><p class="micro-label">Out in the world <span>↗</span></p><a href="/work/the-hooked-tales/"><span>01 / BUSINESS</span><p>The Hooked Tales<br/><em>From a handmade product to a real business.</em></p></a><a href="/work/v20-vr-cricket/"><span>02 / EXPERIENCE</span><p>V20 — VR Cricket<br/><em>A window into the game. No headset required.</em></p></a></div>
    </div>
    <div class="hero-baseline"><a href="#works">Out in the world <span>↗</span></a><span><i class="availability-dot"></i> Open to select collaborations</span><span class="hero-edition">Selected works / 2024—26</span></div>
    </div>
  </section>
  <section id="works" class="works" aria-labelledby="works-title" style={`--gallery-height:${100 + Math.max(0, projects.length - 1) * 100}svh`}>
    <div class="works-stage">
      <div class="section-heading"><h2 id="works-title">Selected works</h2><span class="micro-label"><b data-work-number>01</b> / {projects.length.toString().padStart(2,'0')}</span></div>
      <div class="gallery" aria-label="Featured project gallery">
        {projects.map((project,index)=><a class="gallery-card" href={`/work/${project.slug}/`} data-index={index} aria-label={`Explore ${project.title}`} style={`--project-color:${project.color}`}><ProjectArt project={project} eager={index<3}/><span class="gallery-card-caption">{project.title}<span>View project ↗</span></span></a>)}
      </div>
      <div class="work-caption" aria-live="polite"><div><span class="micro-label" data-work-meta>{projects[0].year} / {projects[0].category}</span><h3 data-work-title>{projects[0].title}</h3><p data-work-description>{projects[0].focus}</p><div class="work-tags" data-work-tags>{projects[0].tags.map(t=><span>{t}</span>)}</div></div><div class="work-actions"><a href={`/work/${projects[0].slug}/`} class="text-link" data-work-link>View project <span>↗</span></a><a href="/works/" class="text-link">All works <span>↗</span></a></div></div>
      <div class="gallery-controls"><button data-gallery-prev aria-label="Previous project">←</button><span class="micro-label">Scroll or explore</span><button data-gallery-next aria-label="Next project">→</button></div>
    </div>
  </section>
  <section id="about" class="manifesto section-pad">
    <span class="micro-label section-index">02 / About</span>
    <h2 data-reveal>Builder by instinct.<br/><span>Operator by necessity.</span></h2>
    <div class="about-columns">
      <div class="about-identity" data-reveal>
        <figure class="profile-portrait">
          <img src="/images/profile/kannan-passport.webp" alt="Balachander Kannan" width="560" height="723" loading="lazy" decoding="async" />
          <figcaption><span>{profile.name}</span><span class="micro-label">{profile.location}</span></figcaption>
        </figure>
        <p class="large-copy">A website should feel like your business before it explains it.</p>
      </div>
      <div class="body-copy" data-reveal><p>{profile.intro}</p><p>I started in enterprise IT operations at TCS, looking at repetitive manual work and asking: why isn’t this automated? That instinct became AI-agent systems, data tools, web products, and a real business — The Hooked Tales.</p><a href="#experience" class="text-link">The story so far ↘</a></div>
    </div>
    <div class="vision"><span class="micro-label">My approach / Webperience</span><p data-reveal>Make it <i>felt.</i><br/>Then make it <i>work.</i></p><span class="vision-caption">Design, engineering, and a reason to exist.</span></div>
  </section>
  <section id="experience" class="experience section-pad">
    <div class="section-heading"><h2>From operating<br/>to building.</h2><span class="micro-label">03 / Experience</span></div>
    <div class="timeline">
      <article data-reveal><span class="micro-label">01 / Enterprise</span><div><h3>Tata Consultancy Services</h3><h4>Assistant Systems Engineer — End User Computing</h4><p>High-volume enterprise IT operations and internal tooling. Built Radia Remediation: a VBA automation that detects files, remaps statuses in two phases, and produces SharePoint-ready spreadsheets.</p></div></article>
      <article data-reveal><span class="micro-label">02 / 2024 — Present</span><div><h3>Independent builder</h3><h4>AI agents, data tools & automation</h4><p>AI-agent systems, data tools, and workflow automation built around clear architecture, human judgment, and ownership of the outcome.</p></div></article>
      <article data-reveal><span class="micro-label">03 / 2024 — Present</span><div><h3>The Hooked Tales</h3><h4>Co-founder — operations, web & marketing</h4><p>Product planning, pricing, a live retail launch, the website, and the ongoing commercial operation of a handmade crochet business.</p></div></article>
      <article data-reveal><span class="micro-label">04 / 2024 — Present</span><div><h3>Independent client work</h3><h4>Web design & development</h4><p>Hokkaido and V20 VR Cricket. Websites that translate the atmosphere and identity of a business into an experience in the browser.</p></div></article>
    </div>
    <div class="credential"><span class="credential-mark" aria-hidden="true">✳</span><div><span class="micro-label">Microsoft certification</span><h3>Azure AI Fundamentals</h3><p>Foundational cloud-AI literacy, applied to real agent and automation systems.</p></div></div>
  </section>
  <section id="capabilities" class="capabilities section-pad">
    <div class="section-heading"><h2>Ideas, made real.</h2><span class="micro-label">04 / Capabilities</span></div>
    <div class="capability-grid">{capabilities.map((item,i)=><article data-reveal><span class="micro-label">0{i+1}</span><h3>{item.title}<span>↗</span></h3><p>{item.text}</p><span class="micro-label">{item.tags}</span></article>)}</div>
    <div class="ai-statement"><span class="micro-label">How I build</span><p data-reveal>AI accelerates the work.<br/><span>I own the decisions.</span></p><div class="body-copy">Research, prototyping, debugging, and iteration move faster with AI. Problem definition, architecture, UX judgment, validation, and final accountability stay with me.</div></div>
  </section>
  <section id="contact" class="contact-section section-pad">
    <span class="micro-label"><i class="availability-dot"></i> Open to select freelance & collaboration work</span>
    <h2 data-reveal>Let’s build<br/><i>something useful.</i></h2>
    <div class="contact-row"><p>A brand with a story.<br/>A product with a purpose.<br/>A process worth improving.</p><a class="contact-circle" href={profile.linkedin} target="_blank" rel="noreferrer" aria-label="Contact Balachander Kannan on LinkedIn">Let’s talk<span>↗</span></a></div>
    <a class="text-link" href={profile.linkedin} target="_blank" rel="noreferrer">Find me on LinkedIn ↗</a>
  </section>
</Studio>
