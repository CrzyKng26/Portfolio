---
import Studio from '../../layouts/Studio.astro';
import ProjectArt from '../../components/studio/ProjectArt.astro';
import {projects, profile} from '../../data/portfolio';
export function getStaticPaths() { return projects.map((project,index)=>({params:{slug:project.slug},props:{project,next:projects[(index+1)%projects.length]}})); }
const {project,next}=Astro.props;
---
<Studio title={`${project.title} — Balachander Kannan`} description={project.description}>
  <article class="project-detail section-pad">
    <a href="/works/" class="text-link">← All works</a>
    <div class="detail-heading"><span class="micro-label">{project.category} / {project.year}</span><h1>{project.title}</h1><p>{project.focus}</p></div>
    <figure><ProjectArt project={project} eager/><figcaption class="micro-label">{project.art}</figcaption></figure>
    <div class="detail-body"><div><span class="micro-label">Role</span><p>{project.role}</p><span class="micro-label">Stack</span><div class="work-tags">{project.tags.map(t=><span>{t}</span>)}</div><span class="micro-label">Status</span><p>{project.status}</p></div><div><h2>The idea</h2><p class="large-copy">{project.description}</p><h2>The work</h2><ul>{project.details.map(item=><li>{item}</li>)}</ul><div class="detail-links">{project.live ? <a class="contact-pill" href={project.live} target="_blank" rel="noreferrer">Visit live website ↗</a> : <a class="contact-pill" href={profile.linkedin} target="_blank" rel="noreferrer">Ask about this project ↗</a>}{project.slug !== 'porca-vaca' && <a class="text-link" href={`${profile.original}/work/${project.slug}`} target="_blank" rel="noreferrer">Original case study ↗</a>}</div></div></div>
    <section class="project-preview" aria-labelledby="preview-heading">
      <div class="section-heading"><h2 id="preview-heading">In the browser.</h2><span class="micro-label">Website preview</span></div>
      <figure>
        <div class="browser-bar" aria-hidden="true"><span class="browser-dots"><i></i><i></i><i></i></span><span>{new URL(project.live).hostname}</span><span>↗</span></div>
        <a href={project.live} target="_blank" rel="noreferrer" aria-label={`Open ${project.title} live website`}><img src={project.screenshot} alt={project.screenshotAlt} width="1280" height="720" loading="lazy" decoding="async" /></a>
        <figcaption class="micro-label">{project.title} / Live website capture</figcaption>
      </figure>
    </section>
    <a class="next-project" href={`/work/${next.slug}/`}><span class="micro-label">Next project</span><h2>{next.title} <span>↗</span></h2></a>
  </article>
</Studio>
